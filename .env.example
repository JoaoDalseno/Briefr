# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Rode `npm run stripe:setup` para gerar esses IDs
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID=
NEXT_PUBLIC_STRIPE_AGENCY_PRICE_ID=

# Upstash Redis (rate limiting)
# Free tier: https://console.upstash.com/
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Sentry (DSN não é secret — pode usar o mesmo valor em ambas)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Resend (alertas operacionais)
RESEND_API_KEY=
ADMIN_ALERT_EMAIL=

# Admin
# Lista de emails separados por vírgula com acesso ao /admin
ADMIN_EMAILS=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
