# Normalize line endings
* text=auto

# Force shell scripts to LF (hooks must run in bash)
*.sh text eol=lf
.husky/* text eol=lf

# Force these to LF as well
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.css text eol=lf

# Binary files
*.ico binary
*.woff binary
*.woff2 binary
*.png binary
*.jpg binary
*.jpeg binary
