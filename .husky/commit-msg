#!/usr/bin/env sh
# commit-msg hook: validates Conventional Commits format.
# Valid: feat(scope): description
# Types: feat | fix | chore | docs | style | refactor | test | perf | ci | build | revert

COMMIT_MSG_FILE="$1"
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")

PATTERN='^(feat|fix|chore|docs|style|refactor|test|perf|ci|build|revert)(\([a-zA-Z0-9_-]+\))?: .{1,100}$'

if ! echo "$COMMIT_MSG" | grep -qE "$PATTERN"; then
  echo ""
  echo "============================================================"
  echo "  COMMIT BLOQUEADO: mensagem fora do padrão Conventional Commits."
  echo ""
  echo "  Formato esperado:"
  echo "    tipo(escopo): descrição curta"
  echo ""
  echo "  Tipos válidos:"
  echo "    feat     — nova funcionalidade"
  echo "    fix      — correção de bug"
  echo "    chore    — tarefas de manutenção (deps, configs)"
  echo "    docs     — documentação"
  echo "    style    — formatação, sem mudança de lógica"
  echo "    refactor — refatoração sem feat nem fix"
  echo "    test     — testes"
  echo "    perf     — melhorias de performance"
  echo "    ci       — CI/CD"
  echo "    build    — sistema de build"
  echo "    revert   — reverte commit anterior"
  echo ""
  echo "  Exemplos válidos:"
  echo "    feat(brief): adicionar geração por formato UGC"
  echo "    fix(auth): corrigir redirect após login"
  echo "    chore: atualizar dependências"
  echo "============================================================"
  exit 1
fi

exit 0
